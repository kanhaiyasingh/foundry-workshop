# Shared environment variables for the Microsoft Foundry workshop labs.
#
# 1. Copy this file to `.env`  ->  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# 2. Replace every <placeholder> with a real value.
# 3. Authentication is keyless — it uses `az login` (AzureCliCredential /
#    DefaultAzureCredential), so there are NO model/account keys in this file.
# 4. `.env` is gitignored; never commit real values.

# ── Required for all labs ────────────────────────────────────────────────────

# Your Azure subscription GUID. Find it with: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# Required for M11 --apply and --cleanup ARM operations.
AZURE_RESOURCE_GROUP=<your-resource-group>

# The Foundry PROJECT endpoint (note the /api/projects/<project> suffix).
# Foundry portal → your project → Overview → "Project endpoint".
# Used by chat / responses / agents. (For embeddings & the eval LLM-judge the
# labs derive the ACCOUNT endpoint by stripping the /api/projects/<project> part.)
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Deployment name (not the base model id) of your chat model deployment.
CHAT_MODEL=gpt-4.1-mini

# Deployment name of your text-embedding model (M4, M6, M7).
EMBEDDING_MODEL=text-embedding-3-large

# ── Optional — only needed by specific labs ──────────────────────────────────

# A reasoning-model deployment (e.g. o4-mini). Used by M1 (notes) and M13.
REASONING_MODEL=o4-mini

# A deep-research model deployment (e.g. o3-deep-research). Used by M8.
RESEARCH_MODEL=o3-deep-research

# Azure AI Search service endpoint. Used by M4 (grounding/RAG) and M7 (memory).
# Search service → Overview → "Url".
SEARCH_ENDPOINT=https://<search>.search.windows.net

# Name of the Foundry PROJECT CONNECTION used for grounding (M4). This must be a
# RemoteTool / CustomKeys connection whose metadata type is knowledgeBase_MCP and
# whose target is the knowledge base's /knowledgebases/<kb>/mcp endpoint — an
# auto-created "AzureCognitiveSearch" connection will NOT work (returns 401).
SEARCH_CONNECTION=<your-foundry-iq-kb-connection-name>

# MCP tool server (M5). URL of your MCP server's SSE endpoint, including its key.
# Foundry portal → Platform → MCP tool servers.
MCP_SERVER_URL=https://<host>/runtime/webhooks/mcp/sse?code=<key>

# Friendly label the agent shows for the MCP server above (M5).
MCP_SERVER_LABEL=project_tracker

# Name of the tool-catalog project connection that wraps the MCP server (M5, §6).
MCP_CONNECTION=project-tracker-mcp

# Work IQ MCP endpoint and label (M5b). URL includes its access key.
WORKIQ_MCP_URL=https://<host>/workiq/mcp?code=<key>
WORKIQ_MCP_LABEL=work_iq

# Application Insights connection string for tracing (M10). Copy the FULL string
# (InstrumentationKey=...;IngestionEndpoint=...;...) from the App Insights resource
# → Overview → "Connection String". Treat it as a secret — keep it only in .env.
APP_INSIGHTS_CONN_STRING=<application-insights-connection-string>
