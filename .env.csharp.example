# C#/.NET environment template. Copy to .env. Do not commit .env.
# Authentication is keyless: run `az login`; no model keys are required.

# Core Foundry configuration (M1-M8, M10, M12-M15 cloud modes)
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_TENANT_ID=
AZURE_AUTH_MODE=default
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large

# Optional models
REASONING_MODEL=o4-mini
RESEARCH_MODEL=o3-deep-research

# Azure AI Search / Foundry IQ (M4)
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_CONNECTION=<foundry-remote-tool-connection-name>

# MCP (M5)
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_SERVER_LABEL=microsoft_learn
MCP_CONNECTION=

# Work IQ (M5b). This endpoint may contain access material; keep it only in .env.
WORKIQ_MCP_URL=
WORKIQ_MCP_LABEL=work_iq

# Azure Monitor (M10, optional M15)
APP_INSIGHTS_CONN_STRING=

# Management-plane labs (M11)
AZURE_RESOURCE_GROUP=<foundry-resource-group>
FOUNDRY_ACCOUNT_NAME=<foundry-account-name>
GUARDRAIL_MODEL_VERSION=

# Fine-tuning (M14 --submit)
FINE_TUNE_MODEL=
FINE_TUNE_TRAINING_TYPE=globalStandard
